# MongoDB Connection
# Use a plain replica-set URI (mongodb://host:port/?replicaSet=RS0&...) if the
# mongodb+srv:// DNS-SRV lookup fails on your network
MONGODB=mongodb://localhost:27017/valorisvisio

# CoinGecko (free demo key: https://www.coingecko.com/en/api)
# Required - the /coins/markets endpoint returns 403 without it
COINGECKO_API_KEY=your-coingecko-demo-key

# Admin Credentials (Change these!)
ADMIN_USERNAME=admin
# Generate password hash using: node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
# Must be a full 64-char SHA-256 hex digest in production
ADMIN_PASSWORD_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Session Secret (Use a strong random string in production)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Contact form SMTP (Gmail app password or equivalent)
EMAIL=you@gmail.com
EMAIL_PASS=your-app-password

# OpenAI (required for AI article generation)
OPENAI_API_KEY=sk-...

# Model for article text generation (OpenAI Responses API)
OPENAI_TEXT_MODEL=gpt-6-luna
# Model for header image generation (Responses API image tool)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Internal bot tool (scripts/internal-bot.mjs)
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=your-admin-password

# Next.js Environment
NODE_ENV=development